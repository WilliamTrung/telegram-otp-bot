# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Local HTTP Server Port
PORT=8080

# Redis Connection URL (e.g. redis://localhost:6379/0). Leave empty to use local JSON file fallback.
REDIS_URL=

# Local JSON database file path (e.g. /app/data/store.json).
DATA_FILE=/app/data/store.json

# Optional log file path. Leave empty to log to stdout only (e.g. /app/logs/gateway.log).
LOG_FILE=/app/logs/gateway.log
