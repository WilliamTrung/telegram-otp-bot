# ==============================================================================
# Deployment Environment Configuration Template (deploy.env.example)
# Copy this file to 'deploy.env' and modify the values for your environment.
# ==============================================================================

# General Environment (e.g., production, staging, development)
ENV=production

# Public/Host port mapping for the Gateway container (maps host PORT to container 8080)
PORT=8080

# Path to the application secrets environment file (containing TELEGRAM_BOT_TOKEN, REDIS_URL, etc.)
# Absolute paths or relative paths from the docker-compose.yml location are supported.
GATEWAY_ENV_FILE=./.env

# Path to the persistent data directory on the host machine
# Used for storing local fallback databases (like store.json) when Redis is not available.
GATEWAY_DATA_DIR=./data
